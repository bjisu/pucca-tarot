# ── 뿌까 오라클 환경 변수 예시 ─────────────────────────
# 이 파일을 복사해서 .env 로 저장한 뒤 실제 키를 채워 넣으세요.
# (.env 는 .gitignore 에 의해 git 에 올라가지 않습니다)

# 사용할 LLM 제공사: anthropic / openai / gemini
# 비워두면 키가 입력된 제공사를 자동으로 선택합니다.
LLM_PROVIDER=

# 셋 중 하나만 채워도 됩니다. 키가 하나도 없으면
# 카드 기본 의미로 만든 내장 해석(오프라인 모드)으로 동작합니다.
ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here

# 모델을 바꾸고 싶을 때만 수정하세요.
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash
